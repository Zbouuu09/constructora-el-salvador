# Desarrollo local: dejar DATABASE_URL vacía usa PostgreSQL embebido PGlite.
# En la nube, establecer la conexión privada provista por Render.
DATABASE_URL=
DATA_DIR=./data/postgres
PORT=3000
HOST=0.0.0.0
# Para una conexión externa, añadir ?sslmode=require a DATABASE_URL.
# Render en la misma región utiliza la conexión interna privada.
